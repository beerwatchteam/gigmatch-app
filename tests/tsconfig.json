{
  "compilerOptions": {
    "module":            "commonjs",
    "target":            "es2021",
    "esModuleInterop":   true,
    "strict":            true,
    "skipLibCheck":      true,
    "moduleResolution":  "node",
    "allowSyntheticDefaultImports": true,
    "allowJs":           true,
    "ignoreDeprecations": "6.0",
    "types":             ["jest", "node"],
    "baseUrl":           "..",
    "paths": {}
  },
  "include": [
    "./**/*.ts"
  ]
}
