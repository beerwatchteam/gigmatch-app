rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isSignedIn() && getUserData().type == 'admin';
    }
    function isVenueOwner(venueId) {
      return isSignedIn() && getUserData().venueId == venueId;
    }
    function isAgentForArtist(artistUid) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/agentRoster/$(request.auth.uid + '_' + artistUid));
    }
    function isAgentForVenue(venueId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/agentVenueRoster/$(request.auth.uid + '_' + venueId));
    }

    // Returns true if the current user is allowed to read/write an inquiry,
    // given the inquiry's data object.
    function canAccessInquiry(inqData) {
      return isSignedIn() && (
        inqData.createdBy == request.auth.uid ||
        isVenueOwner(inqData.venueId) ||
        (inqData.keys().hasAll(['participantUids']) &&
         request.auth.uid in inqData.participantUids) ||
        isAgentForArtist(inqData.createdBy) ||
        isAgentForVenue(inqData.venueId) ||
        isAdmin()
      );
    }

    // ── Users ────────────────────────────────────────────────────────────────
    // Public read is needed for username uniqueness checks before signup (unauthenticated).
    // display names, usernames, and user types are not sensitive, and email
    // is already exposed on the publicly readable bandProfiles/agentProfiles collections.
    match /users/{uid} {
      allow read:   if true;
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Band profiles ────────────────────────────────────────────────────────
    match /bandProfiles/{uid} {
      allow read:   if true;
      allow create: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid) || isAdmin() ||
        (isSignedIn() && exists(/databases/$(database)/documents/agentRoster/$(request.auth.uid + '_' + uid)));
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ── Agent roster ─────────────────────────────────────────────────────────
    match /agentRoster/{entryId} {
      allow read:   if isSignedIn();
      allow create, update: if isSignedIn() &&
        request.resource.data.agentUid == request.auth.uid;
      allow delete: if isSignedIn() &&
        resource.data.agentUid == request.auth.uid || isAdmin();
    }

    // ── Agent venue claims ───────────────────────────────────────────────────
    match /agentVenueClaims/{claimId} {
      allow read: if isSignedIn() && (
        resource.data.agentUid == request.auth.uid ||
        resource.data.venueId  == getUserData().venueId ||
        isAdmin()
      );
      allow create: if isSignedIn() &&
        request.resource.data.agentUid == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.agentUid == request.auth.uid ||
        resource.data.venueId  == getUserData().venueId ||
        isAdmin()
      );
      allow delete: if isAdmin() ||
        resource.data.agentUid == request.auth.uid ||
        resource.data.venueId  == getUserData().venueId;
    }

    // ── Agent venue roster ───────────────────────────────────────────────────
    match /agentVenueRoster/{entryId} {
      allow read:   if isSignedIn();
      allow create, update: if isSignedIn() &&
        request.resource.data.agentUid == request.auth.uid;
      allow delete: if isSignedIn() &&
        resource.data.agentUid == request.auth.uid || isAdmin();
    }

    // ── Venues ───────────────────────────────────────────────────────────────
    match /venues/{venueId} {
      allow read:   if true;
      allow create: if isSignedIn();
      allow update: if isVenueOwner(venueId) || isAdmin();
      allow delete: if isVenueOwner(venueId) || isAdmin();

      match /gigNights/{nightId} {
        allow read:  if true;
        allow write: if isVenueOwner(venueId) || isAdmin();
      }

      match /bookings/{bookingId} {
        allow read:  if isSignedIn();
        allow write: if isVenueOwner(venueId) || isAdmin();
      }
    }

    // ── Musicians ────────────────────────────────────────────────────────────
    match /musicians/{uid} {
      allow read:   if true;
      allow create: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ── Agent profiles ───────────────────────────────────────────────────────
    match /agentProfiles/{uid} {
      allow read:   if true;
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Agent claims ─────────────────────────────────────────────────────────
    // Agent can create and read their own claims.
    // Musician (artistUid) can read and update (approve/decline) claims for them.
    match /agentClaims/{claimId} {
      allow read: if isSignedIn() && (
        resource.data.agentUid == request.auth.uid ||
        resource.data.artistUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() &&
        request.resource.data.agentUid == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.artistUid == request.auth.uid ||
        resource.data.agentUid  == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin() ||
        resource.data.agentUid == request.auth.uid ||
        resource.data.artistUid == request.auth.uid;
    }

    // ── Venue applications ───────────────────────────────────────────────────
    match /venueApplications/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Venue disputes ───────────────────────────────────────────────────────
    match /venueDisputes/{disputeId} {
      allow read:   if isSignedIn() && (
        resource.data.challengerUserId == request.auth.uid ||
        resource.data.currentOwnerId  == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Inquiries ────────────────────────────────────────────────────────────
    match /inquiries/{inquiryId} {

      // Headliner, venue owner, support acts (participantUids), and admin can read.
      allow read: if canAccessInquiry(resource.data);

      // Only the artist submitting the enquiry can create it.
      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid;

      // Headliner, venue owner, support acts (e.g. adding themselves to deletedBy), admin.
      allow update: if canAccessInquiry(resource.data);

      // Only the headliner or admin can hard-delete.
      allow delete: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid ||
        isAdmin()
      );

      // ── Participants subcollection ────────────────────────────────────────
      // Any participant of the gig can read the participant list.
      // Only venue owner or headliner can create (invite) participants.
      // A participant can update their own record (e.g. state -> left);
      // venue owner can update any participant's record (e.g. remove).
      match /participants/{participantId} {
        allow read: if canAccessInquiry(
          get(/databases/$(database)/documents/inquiries/$(inquiryId)).data
        );
        allow create: if isSignedIn() && (
          get(/databases/$(database)/documents/inquiries/$(inquiryId)).data.createdBy == request.auth.uid ||
          isVenueOwner(
            get(/databases/$(database)/documents/inquiries/$(inquiryId)).data.venueId
          ) ||
          isAdmin()
        );
        allow update: if isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          isVenueOwner(
            get(/databases/$(database)/documents/inquiries/$(inquiryId)).data.venueId
          ) ||
          isAdmin()
        );
        allow delete: if false;
      }

      // ── 1:1 sub-threads ───────────────────────────────────────────────────
      // Any participant of the parent gig can create/read sub-thread docs.
      match /subThreads/{subThreadId} {
        allow read, create, update: if canAccessInquiry(
          get(/databases/$(database)/documents/inquiries/$(inquiryId)).data
        );
        allow delete: if false;

        // Sub-thread messages: same access as the sub-thread itself.
        match /messages/{messageId} {
          allow read:   if canAccessInquiry(
            get(/databases/$(database)/documents/inquiries/$(inquiryId)).data
          );
          allow create: if isSignedIn() &&
            request.resource.data.senderId == request.auth.uid &&
            canAccessInquiry(
              get(/databases/$(database)/documents/inquiries/$(inquiryId)).data
            );
          allow update, delete: if false;
        }
      }
    }

    // ── Messages (flat collection — enquiry group chat) ───────────────────────
    // Any signed-in user can read (messages contain no sensitive data beyond the enquiry).
    // Create: sender must be the current user, OR it's a system message (sender == '').
    // System messages are posted client-side by a user who has enquiry access.
    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.sender == request.auth.uid ||
        (request.resource.data.get('type', '') == 'system' &&
         request.resource.data.sender == '')
      );
      allow update, delete: if false;
    }

    // ── Gigs ─────────────────────────────────────────────────────────────────
    match /gigs/{gigId} {
      function isParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participantIds;
      }

      allow read:   if isParticipant() || isAdmin();
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantIds;
      allow update: if isParticipant() || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Admin settings ───────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Direct messages ──────────────────────────────────────────────────────
    match /directMessages/{convId} {
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() &&
        request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          request.auth.uid in
            get(/databases/$(database)/documents/directMessages/$(convId)).data.participants
        );
        allow create: if isSignedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          request.auth.uid in
            get(/databases/$(database)/documents/directMessages/$(convId)).data.participants;
        allow update, delete: if false;
      }
    }
  }
}
