{
  "name": "gigmatch-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.11",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "expo": "~57.0.14",
    "expo-calendar": "~57.0.4",
    "expo-constants": "~57.0.12",
    "expo-document-picker": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.11",
    "expo-linking": "~57.0.6",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.14",
    "expo-sharing": "~57.0.21",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.17.1",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "firebase-admin": "^14.4.0",
    "firebase-functions-test": "^3.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "build:functions": "cd functions && npm run build",
    "emulate": "firebase emulators:start --only functions,firestore",
    "deploy:functions": "cd functions && npm run deploy",
    "test:unit": "jest --testPathPattern='tests/unit'",
    "test:rules": "firebase emulators:exec --only firestore,auth,storage \"jest --testPathPattern='tests/rules'\"",
    "test:functions": "npm run build:functions && firebase emulators:exec --only firestore,auth,functions,pubsub \"jest --runInBand --testPathPattern='tests/functions'\"",
    "test:all": "npm run build:functions && firebase emulators:exec --only firestore,auth,storage,functions,pubsub \"jest --runInBand\""
  },
  "private": true
}
